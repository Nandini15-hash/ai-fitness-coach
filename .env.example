# Any OpenAI-compatible provider. Server-only: do NOT prefix with NEXT_PUBLIC_.
# Leave AI_API_KEY empty to use the built-in sample plans.

# --- Option 1: Google Gemini (free tier, no card) ---
# Key: https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# (If this model errors, copy a current free model ID from aistudio.google.com)

# --- Option 2: Groq (free tier, no card) ---
# Key: https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=<pick a model from console.groq.com/docs/models>

# --- Option 3: OpenAI (paid) ---
# AI_BASE_URL=   (leave empty)
# AI_MODEL=gpt-4o-mini
